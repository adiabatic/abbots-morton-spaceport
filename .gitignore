# Python-generated files
__pycache__/
*.py[oc]

# Virtual environments
.venv
.uv-cache/

# Build stuff
/site/AbbotsMortonSpaceport*.otf
/site/AbbotsMortonSpaceport*.fea
/site/DepartureMono-Regular.otf
/site/*.woff2
/site/print.pdf
/engine/kernel-rs/target/
