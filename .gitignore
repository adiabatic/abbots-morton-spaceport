# Scratch files, wiped freely between change sets
tmp/

# Kept output: cycle build logs, review-corpus snapshots, hand-kept archives, the verdict orphans and the kerning view's journal
/var/

# Engine output: the build, the review corpus, green records, and the cycle-timings journal
engine/out/

# Claude Code local state
.claude/scheduled_tasks.lock

# Review-app verdict files
/verdicts-*.json
/verdicts.json
/verdicts-autosave.json.lock
